# ===================================================================
# Procura — Git Ignore Rules
# ===================================================================

# ── Environment & Secrets ─────────────────────────────────────────
.env
*.env
**/.env
**/*.env
.env.*
.env.example
*.env.example
**/.env.example

# ── Python Artifacts ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
wheels/
*.egg-info/
*.egg
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ── Virtual Environments ──────────────────────────────────────────
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ── Databases & Local Storage ─────────────────────────────────────
*.db
*.sqlite
*.sqlite3
data/*.db
backend/data/*.db

# ── Uploaded Files & Temporary Storage ────────────────────────────
uploads/*
backend/uploads/*
!uploads/.gitkeep
!backend/uploads/.gitkeep

# ── Node.js / Frontend ────────────────────────────────────────────
node_modules/
**/node_modules/
frontend/dist/
dist-ssr/
*.local

# ── Logs ──────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── IDEs & Operating Systems ──────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
